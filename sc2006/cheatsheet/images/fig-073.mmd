classDiagram
 direction LR
    class BrowserClient {
        +sendRequest()
    }
    class SecureTaskFacade {
        +perform()
    }
    class AccessPolicy {
        +authorise() bool
    }
    class TaskService {
        +performApproved()
    }
    class AuditStore {
        +record()
    }
    BrowserClient --> SecureTaskFacade
    SecureTaskFacade --> AccessPolicy
