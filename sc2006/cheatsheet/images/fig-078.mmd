classDiagram
    class SensorSubject {
        <<interface>>
        +attach()
        +detach()
        +notify()
    }
    class Sensor {
        +id
        +lastMeasurement
        +attach()
        +detach()
        +notify()
    }
    class MeasurementObserver {
        <<interface>>
        +update()
    }
    class DWSMonitor {
        +lastSeenBySensor
        +update()
        +checkSilence()
    }
    class RegistrationService {
        +registerSensor()
        +deregisterSensor()
        +registerAlert()
        +link()
        +unlink()
    }
    class Link {
        +sensorId
        +alertId
        +lower
        +width
        +outside() bool
    }
    class AlertGateway {
        +send()
        +warnManager()
    }
    class RecordStore {
        +append()
        +readAll()
    }
    SensorSubject <|.. Sensor
    SensorSubject --> MeasurementObserver : subscribers
    MeasurementObserver <|.. DWSMonitor
    RegistrationService --> SensorSubject : attach / detach DWS monitor
    RegistrationService --> Link
    RegistrationService --> RecordStore
    DWSMonitor --> Link
    DWSMonitor --> AlertGateway
    DWSMonitor --> RecordStore
