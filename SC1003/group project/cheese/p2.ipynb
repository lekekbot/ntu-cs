def check_team_quality(team_assignments):
    """Simple analysis with more reasonable gender checking"""
    teams = defaultdict(list)
    
    # Group students by their assigned teams
    for student_record in team_assignments:
        team_key = (student_record["Tutorial Group"], student_record["Team Assigned"])
        teams[team_key].append(student_record)
    
    school_problems = 0
    gender_problems = 0
    all_team_grades = []
    
    # Check each team
    for team_key, team_members in teams.items():
        team_size = len(team_members)
        
        # Count schools and genders
        school_counts = Counter([member["School"] for member in team_members])
        gender_counts = Counter([member["Gender"] for member in team_members])
        team_cgpas = [member["CGPA"] for member in team_members]
        
        # School problem: more than 50% from same school
        max_allowed_school = team_size // 2
        if max(school_counts.values()) > max_allowed_school:
            school_problems += 1
        
        # Gender problem: ALL students are same gender (much more reasonable!)
        if len(gender_counts) == 1 and team_size > 2:
            gender_problems += 1
        
        # Track team grades
        all_team_grades.append(mean(team_cgpas))
    
    # Create summary
    summary = {
        "total_teams": len(teams),
        "school_problems": school_problems,
        "gender_problems": gender_problems,
        "average_team_grade": mean(all_team_grades)
    }
    
    return summary, all_team_grades


def show_team_charts(summary, team_grades):
    """Simple charts showing team quality"""
    
    # Chart 1: Problems overview
    plt.figure(figsize=(10, 4))
    
    plt.subplot(1, 2, 1)
    problems = ["School\nProblems", "Gender\nProblems"]
    counts = [summary["school_problems"], summary["gender_problems"]]
