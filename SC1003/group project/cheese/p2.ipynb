    "# === Run the Complete Process ===\n",
    "\n",
    "# Step 1: Load all student data\n",
    "print(\"Loading student data...\")\n",
    "all_students = load_records(\"records.csv\")\n",
    "print(f\"Loaded {len(all_students)} students\")\n",
    "\n",
    "# Step 1.5: Analyze the raw data to understand gender distribution\n",
    "print(\"\\n=== DATA ANALYSIS ===\")\n",
    "gender_counts = Counter([student[\"gender\"] for student in all_students])\n",
    "print(\"Overall Gender Distribution:\")\n",
    "for gender, count in gender_counts.items():\n",
    "    percentage = (count / len(all_students)) * 100\n",
    "    print(f\"  {gender}: {count} students ({percentage:.1f}%)\")\n",
    "\n",
    "# Analyze by tutorial group\n",
    "tutorial_groups = group_by_tutorial(all_students)\n",
    "print(f\"\\nGender distribution by tutorial group:\")\n",
    "for group_name, students in tutorial_groups.items():\n",
    "    group_gender_counts = Counter([s[\"gender\"] for s in students])\n",
    "    print(f\"  {group_name}: {dict(group_gender_counts)}\")\n",
    "\n",
    "# Step 2: Create balanced teams\n",
    "print(\"\\nCreating balanced teams...\")\n",
    "team_assignments = process_all_students(all_students, team_size=5)\n",
    "\n",
    "# Step 3: Save results to file\n",
    "print(\"Saving results...\")\n",
    "with open(\"output.csv\", \"w\", newline=\"\", encoding=\"utf-8\") as output_file:\n",
    "    writer = csv.DictWriter(output_file, fieldnames=team_assignments[0].keys())\n",
    "    writer.writeheader()\n",
    "    writer.writerows(team_assignments)\n",
    "\n",
    "# Step 4: Analyze and display results\n",
    "print(\"\\n=== RESULTS ANALYSIS ===\")\n",
    "performance_summary, team_stats = analyze_team_results(team_assignments)\n",
    "print(\"Performance Summary:\", performance_summary)\n",
    "\n",
    "# Calculate violation rates\n",
    "total_teams = performance_summary[\"total_teams\"]\n",
    "school_violation_rate = (performance_summary[\"school_violations\"] / total_teams) * 100\n",
    "gender_violation_rate = (performance_summary[\"gender_violations\"] / total_teams) * 100\n",
    "\n",
    "print(f\"\\nViolation Analysis:\")\n",
    "print(f\"  School violations: {performance_summary['school_violations']} out of {total_teams} teams ({school_violation_rate:.1f}%)\")\n",
    "print(f\"  Gender violations: {performance_summary['gender_violations']} out of {total_teams} teams ({gender_violation_rate:.1f}%)\")\n",
    "\n",
    "print(\"\\nCreating charts...\")\n",
    "create_performance_charts(performance_summary, team_stats)"
   ]
